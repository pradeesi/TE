# ==============================================================================
# Purpose: Template environment configuration for the GCP Telecom ADK Agent.
# Architecture/Context: Configures Google Cloud Agent Runtime, Cloud VPN / PSC
#                       connectivity to the On-Premises Apigee API Proxy,
#                       flexible Apigee authentication, Agent Registry, and
#                       GCP Agent Runtime logging/monitoring telemetry.
# Dependencies/Side Effects: Copy to .env before running locally or deploying
#                            with ./deploy_gcp.sh. Never commit .env.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Cloud & Vertex AI Agent Runtime Configuration
# ------------------------------------------------------------------------------
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
MODEL_NAME=gemini-2.5-flash

# Agent Metadata (Used for Agent Runtime & Agent Registry)
AGENT_NAME=telecom_agent_hybrid_apigee
AGENT_DISPLAY_NAME="Telecom Customer Care Agent (Hybrid via Apigee)"
AGENT_IDENTITY=telecom-customer-care-agent-hybrid-apigee
DEFAULT_END_USER_EMAIL=operator@telecom.enterprise

# ------------------------------------------------------------------------------
# 2. On-Premises Apigee Proxy Endpoint (Reached over Cloud VPN)
# ------------------------------------------------------------------------------
# Base URL of the Apigee API Proxy forwarding to the On-Premises MCP Server.
# The agent appends `/mcp` automatically when invoking JSON-RPC 2.0 tools.
# Examples:
#   - Private IP / Internal DNS over Cloud VPN: https://apigee.onprem.internal/telecom-mcp
#   - Internal IP over Cloud VPN:               http://10.128.0.10:8080/telecom-mcp
#   - NIP.io / Public Apigee Ingress:           https://demo-group.35.244.243.231.nip.io/te-mcp
MCP_SERVER_URL=https://apigee.onprem.internal/telecom-mcp

# Set to false if the on-premises Apigee ingress uses a self-signed or private CA certificate
APIGEE_VERIFY_SSL=true
MCP_TIMEOUT_SECONDS=30.0

# ------------------------------------------------------------------------------
# 3. Flexible Apigee Authentication Configuration
# ------------------------------------------------------------------------------
# Supported APIGEE_AUTH_MODE values:
#   - auto            : Automatically attaches credentials based on which variables
#                       below are set (API Key, Bearer Token, Custom Header, or OIDC).
#                       If none are set, sends requests without auth headers.
#   - none            : No authentication headers sent (rely on Cloud VPN / mTLS).
#   - api_key         : Sends APIGEE_API_KEY in the APIGEE_API_KEY_HEADER (default: x-apikey).
#   - bearer          : Sends Authorization: Bearer <MCP_AUTH_TOKEN> and X-MCP-Token.
#   - google_id_token : Mints a Google OIDC ID token from the GCP metadata server.
#   - basic           : Sends HTTP Basic Auth using APIGEE_BASIC_USER and APIGEE_BASIC_PASSWORD.
#   - custom_header   : Sends APIGEE_CUSTOM_HEADER_NAME: APIGEE_CUSTOM_HEADER_VALUE.
APIGEE_AUTH_MODE=auto

# Option A: Apigee API Key Authentication (when APIGEE_AUTH_MODE=api_key or auto)
APIGEE_API_KEY=
APIGEE_API_KEY_HEADER=x-apikey

# Option B: Bearer / Static Token Authentication (when APIGEE_AUTH_MODE=bearer or auto)
MCP_DEPLOYMENT_TARGET=on_prem
MCP_AUTH_TOKEN=
APIGEE_BEARER_TOKEN=

# Option C: Google OIDC ID Token Audience (when APIGEE_AUTH_MODE=google_id_token)
# Defaults to MCP_SERVER_URL if left empty
APIGEE_OIDC_AUDIENCE=

# Option D: HTTP Basic Authentication (when APIGEE_AUTH_MODE=basic)
APIGEE_BASIC_USER=
APIGEE_BASIC_PASSWORD=

# Option E: Custom Header Authentication (when APIGEE_AUTH_MODE=custom_header)
APIGEE_CUSTOM_HEADER_NAME=
APIGEE_CUSTOM_HEADER_VALUE=

# ------------------------------------------------------------------------------
# 4. Cloud VPN / Private Service Connect (PSC) Network Attachment (Optional)
# ------------------------------------------------------------------------------
# Required when Agent Runtime connects to a private on-premises Apigee IP over
# Cloud VPN. Provide the full Network Attachment resource name:
# projects/<PROJECT_ID>/regions/<REGION>/networkAttachments/<ATTACHMENT_NAME>
NETWORK_ATTACHMENT=
DNS_PEERING_DOMAIN=
DNS_PEERING_PROJECT=
DNS_PEERING_NETWORK=

# Enable SPIFFE Agent Identity on Agent Runtime (true / false)
ENABLE_AGENT_IDENTITY=true

# ------------------------------------------------------------------------------
# 5. GCP Agent Runtime Logging, Tracing & Monitoring Configuration
# ------------------------------------------------------------------------------
# Enables native Vertex AI Agent Runtime OpenTelemetry tracing & Cloud Logging
GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY=true

# Controls GenAI message capture in Cloud Logging / Cloud Trace:
# Options: EVENT_ONLY, SPAN_AND_EVENT, SPAN_ONLY, NO_CONTENT
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=EVENT_ONLY
ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=false
OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental

# GCS Bucket name (without gs://) for storing full prompt/response JSONL completions
# Leave empty to auto-use <GOOGLE_CLOUD_PROJECT>-telecom-agent-logs during deploy_gcp.sh
LOGS_BUCKET_NAME=
LOG_LEVEL=INFO
