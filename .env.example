# ==============================================================================
# Purpose: Environment configuration template for the On-Premises Customer Data
#          Center stack running on an Ubuntu VM via Docker Compose.
# Architecture/Context:
#   - Configures the 6 core on-prem services (PostgreSQL DB Server, MCP Server,
#     CRM Application, Prometheus, Grafana Loki, Grafana) plus Portainer CE.
#   - Apigee Hybrid is installed and managed separately on dedicated VMs and
#     routes northbound agent traffic to http://<UBUNTU_VM_IP>:8001/mcp.
# Dependencies/Side Effects:
#   - Copy this file to `.env` before starting Docker Compose:
#       cp .env.example .env
#   - `.env` is excluded from version control via `.gitignore`.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Network Binding (Customer Network Access)
# ------------------------------------------------------------------------------
# 0.0.0.0 exposes the service ports on all Ubuntu VM network interfaces so they
# can be accessed from the customer network, Postman, and separate Apigee VMs.
BIND_ADDRESS=0.0.0.0

# ------------------------------------------------------------------------------
# 2. Database Server (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_USER=telecom_user
POSTGRES_PASSWORD=telecom_secure_pass
POSTGRES_DB=telecom_db
POSTGRES_PORT=5432

# Host-level connection string (used by host utility scripts; containers use
# the internal `postgres:5432` service hostname automatically).
DATABASE_URL=postgresql+asyncpg://telecom_user:telecom_secure_pass@localhost:5432/telecom_db
DB_ALLOW_SQLITE_FALLBACK=false

# ------------------------------------------------------------------------------
# 3. MCP Server & CRM Application
# ------------------------------------------------------------------------------
APP_ENV=production
LOG_LEVEL=INFO
CRM_PORT=8000
MCP_PORT=8001
DEFAULT_END_USER_EMAIL=unknown-user@telecom.onprem

# ------------------------------------------------------------------------------
# 4. Observability Stack (Prometheus, Grafana Loki, Grafana)
# ------------------------------------------------------------------------------
PROMETHEUS_PORT=9090
LOKI_PORT=3100
# Retain audit logs in Loki for 3 days (72h) to bound disk consumption
LOKI_RETENTION_PERIOD=72h
LOKI_URL=http://localhost:3100
LOKI_AUTH_MODE=none

GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=telecom_admin

# ------------------------------------------------------------------------------
# 5. Container Management (Portainer CE)
# ------------------------------------------------------------------------------
PORTAINER_HTTPS_PORT=9443
PORTAINER_HTTP_PORT=9000
PORTAINER_ADMIN_USER=admin
# Must be at least 12 characters long (auto-initialized by install.sh so Portainer never times out)
PORTAINER_ADMIN_PASSWORD=telecom_admin

